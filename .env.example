# Runtime configuration for the Civitas citizen services server.
#
# Path to the SQLite database. Relative paths are resolved from the current
# working directory to an absolute path. Default: var/citizen.db
CSA_DB_PATH=var/citizen.db

# Secret used to sign citizen tokens. The development default is
# "civitas-dev-secret"; a warning is logged when it is in use. Set a private
# value outside local development.
CSA_TOKEN_SECRET=civitas-dev-secret

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL. Default: INFO.
CSA_LOG_LEVEL=INFO
